{
  "name": "debrief",
  "version": "1.8.3",
  "description": "AI-powered conversation analysis and insight discovery platform",
  "author": {
    "name": "Michael Borck",
    "email": "noreply@example.com"
  },
  "main": "public/electron.js",
  "scripts": {
    "start": "NODE_ENV=development concurrently \"npm run webpack-dev\" \"npm run electron-dev\"",
    "webpack-dev": "webpack serve --mode development",
    "electron-dev": "wait-on http://localhost:9000/bundle.js && electron . --no-sandbox",
    "build": "webpack --mode production",
    "build:sidecar": "bash embedded-server/bundle-python.sh && bash embedded-server/prefetch-models.sh",
    "electron": "electron . --no-sandbox",
    "pack": "npm run build && npm run build:sidecar && electron-builder --dir",
    "dist": "npm run build && npm run build:sidecar && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "postinstall": "electron-builder install-app-deps",
    "download-ffmpeg": "node scripts/download-ffmpeg.js"
  },
  "keywords": [
    "electron",
    "react",
    "transcription",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.26",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitest/ui": "^4.1.5",
    "concurrently": "^9.1.2",
    "css-loader": "^7.1.2",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^29.1.1",
    "postcss-loader": "^8.1.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "wait-on": "^8.0.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.20.0",
    "apache-arrow": "^18.1.0",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^11.10.0",
    "docx": "^9.6.1",
    "ffmpeg-static": "^5.2.0",
    "form-data": "^4.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "node-fetch": "^3.3.2",
    "undici": "^7.25.0",
    "postcss": "^8.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17"
  }
}
