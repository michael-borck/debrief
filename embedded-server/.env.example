# Build-time secrets for the embedded sidecar. Copy to .env and fill in.
# .env is gitignored; .env.example is the template that ships with the repo.

# HuggingFace read-token for downloading gated pyannote models during the
# prefetch-models step. Get one at https://huggingface.co/settings/tokens
# (after accepting terms on pyannote/speaker-diarization-3.1 and
# pyannote/segmentation-3.0). Required for build, not for runtime — the
# bundled binary reads from a baked-in cache.
HF_TOKEN=
